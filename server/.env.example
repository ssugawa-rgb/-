# server/.env の例。必要な項目だけコピーして server/.env を作成してください。
# （.env は .gitignore 済み。パスワード等は絶対にコミットしないこと）

# 待ち受けホスト。既定 127.0.0.1（自PCのみ）。社内LANに公開するなら 0.0.0.0
HOST=127.0.0.1
PORT=8787

# 初期管理者（未指定ならランダムPWを生成して起動時にコンソール表示）
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me-strong-1

# HTTPS(リバースプロキシ)越しに運用する場合は 1 にする（Secureクッキー / HSTS 有効化）
# COOKIE_SECURE=1
# TRUST_PROXY=1

# セッション有効時間（時間）と無操作タイムアウト（分）
SESSION_HOURS=12
IDLE_MINUTES=60

# ログイン失敗ロック
MAX_FAILS=5
LOCK_MINUTES=15

# データ保存先（既定 server/data）
# DATA_DIR=./data
